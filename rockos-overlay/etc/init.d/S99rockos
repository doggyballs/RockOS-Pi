#!/bin/sh

# Show RockOS startup diagnostics on the physical/VM display.
exec >/dev/tty1 2>&1

echo
echo "===== ROCKOS KIOSK STARTUP ====="

export XDG_RUNTIME_DIR=/run/user/0
export WAYLAND_DISPLAY=wayland-0

mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

mkdir -p /var/log

# Launch wvkbd (Wayland virtual keyboard) in hidden mode.
# Toggle visibility via the floating ⌨ button (kbd-toggle overlay)
# or by sending SIGRTMIN to the wvkbd process.
wvkbd --hidden &
WVKBD_PID=$!
echo $WVKBD_PID > /tmp/wvkbd.pid
echo "ROCKOS: virtual keyboard started (pid $WVKBD_PID, hidden)"

# Launch the keyboard toggle button (floating overlay in bottom-right)
kbd-toggle &

echo "ROCKOS: keyboard toggle button started"

export QT_QPA_PLATFORM=wayland
export QTWEBENGINE_DISABLE_SANDBOX=1
export QTWEBENGINE_CHROMIUM_FLAGS="--no-sandbox --in-process-gpu --disable-gpu-sandbox --use-gl=egl"

echo "ROCKOS: starting cage (kiosk compositor) + EntropyLab..."

# cage is a wlroots kiosk compositor that runs a single app fullscreen.
# It supports wlr-layer-shell (needed by wvkbd and kbd-toggle).
# The browser is launched as cage's single client; cage exits when it does.
cage -- /usr/bin/rockos-browser > /var/log/cage.log 2>&1

COMPOSITOR_EXIT=$?
echo "ROCKOS: cage exited with code $COMPOSITOR_EXIT"
