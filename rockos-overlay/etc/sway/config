# RockOS sway kiosk config
# Minimal: no bar, no gaps, single fullscreen app, allow layer-shell overlays

# Don't draw a title bar or borders
default_border none
default_floating_border none
gaps inner 0
gaps outer 0

# No bar
bar {
    mode invisible
}

# Allow wvkbd and kbd-toggle to use layer-shell
# (sway supports wlr-layer-shell by default)

# Auto-fullscreen the browser
for_window [app_id="rockos-browser"] fullscreen

# Don't kill the session if the browser exits — we handle that in S99rockos
# (sway exits when configured to, or when all outputs are gone)

# Input device: use the first touch/mouse/keyboard
input * {
    events enable
}

# Output: use HDMI-A-1 only
output HDMI-A-1 {
    # Resolution is auto-detected from EDID
}

# Disable XWayland (we don't need it)
xwayland disable
