BR2_aarch64=y
BR2_cortex_a76=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_CCACHE=y
BR2_GLOBAL_PATCH_DIR="../patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_TARGET_GENERIC_ISSUE="RockOS"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
# BR2_TARGET_GENERIC_GETTY is not set
BR2_ROOTFS_OVERLAY="../rockos-overlay-cog"
BR2_ROOTFS_POST_BUILD_SCRIPT="../scripts/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="../board/rockos/rpi5/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="../board/rockos/rpi5/linux-rockos-rpi5.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="../board/rockos/rpi5/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="../board/rockos/rpi5/cmdline.txt"
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# Browser engine: WPE WebKit + cog (replaces Qt5/QtWebEngine/rockos-browser)
BR2_PACKAGE_WPEWEBKIT=y
BR2_PACKAGE_COG=y
BR2_PACKAGE_COG_PLATFORM_FDO=y
BR2_PACKAGE_WVKBD=y
BR2_PACKAGE_KBD_TOGGLE=y
BR2_PACKAGE_CAGE=y
# wlroots needs xkb data at runtime (was transitively pulled by sway which
# we removed; without it cage can't init input and hangs at the cursor)
BR2_PACKAGE_XKEYBOARD_CONFIG=y
# wlroots 0.20 color-management uses lcms2 but Buildroot's wlroots.mk
# doesn't declare it (auto-detected at build time). Force it in so cage
# can actually load.
BR2_PACKAGE_LCMS2=y
# BR2_PACKAGE_HWDATA_PCI_IDS is not set
# BR2_PACKAGE_HWDATA_USB_IDS is not set
BR2_PACKAGE_LIBGCRYPT=y
BR2_PACKAGE_LIBEPOXY=y
BR2_PACKAGE_LIBSOUP3=y
BR2_PACKAGE_LIBTASN1=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
# BR2_TARGET_ROOTFS_TAR is not set

###############################################################################
# !!! DEV-ONLY: REMOVE BEFORE PRODUCTION !!!
# Dropbear SSH server for headless bring-up (panel/touch/weston).
# Key-only auth via rockos-overlay/root/.ssh/authorized_keys; root has no
# password. DHCP on eth0 deliberately enabled for headless debug on the
# internet-only VLAN. Neither of these may ship in the prod image.
###############################################################################
BR2_SYSTEM_DHCP="eth0"
BR2_PACKAGE_DROPBEAR=y

BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
