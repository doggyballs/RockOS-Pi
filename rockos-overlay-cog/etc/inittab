# /etc/inittab — RockOS cog variant (sysvinit/busybox init)
#
################################################################################
## !!! DEBUG ONLY — REMOVE BEFORE PRODUCTION / BEFORE ANY UPSTREAM PR !!!
## tty1 root shell for pikvm/console debugging. Paired with dropbear debug
## SSH; remove together with it per DEBUG-REMOVAL-CHECKLIST.md.
#################################################################################
#
# Base sysinit: mounts + rcS (same as Buildroot busybox default)
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# DEBUG root shell on tty1 (no password, no login prompt)
tty1::respawn:/sbin/getty -L tty1 0 vt100

::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
